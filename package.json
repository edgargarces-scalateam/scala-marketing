{
  "name": "scala-marketing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest run",
    "emulators": "firebase emulators:start --project demo-scala",
    "seed": "node scripts/seed.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-scala 'vitest run --config vitest.rules.config.ts'",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "provision-user": "node scripts/provision-user.mjs",
    "test:integration": "firebase emulators:exec --only auth,firestore,storage --project demo-scala 'npm run seed && node scripts/emulator-smoke.mjs'"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "frappe-gantt": "^1.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
